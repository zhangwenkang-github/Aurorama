<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- W6 T9r：Android 11+ 包可见性 —— 枚举已装 TTS 引擎（设备无默认引擎时逐个显式绑定）。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application>
        <!-- W3 R3：入口已接入 NavigationRoot（书籍条目 → 显式 Intent），不再对 adb / 外部应用开放。 -->
        <activity
            android:name="com.zhangwenkang.cinefin.book.presentation.reader.ReaderActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:label="阅读器" />

        <!-- W6 T9（READER-32–36）：听书后台播放。播放本身在阅读页进程内，服务只做通知 /
             锁屏控制镜像，故 exported=false、不可粘性重启。权限由 app 模块统一声明
             （FOREGROUND_SERVICE / FOREGROUND_SERVICE_MEDIA_PLAYBACK / POST_NOTIFICATIONS）。 -->
        <service
            android:name="com.zhangwenkang.cinefin.book.presentation.reader.tts.ReaderTtsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 耳机 / 蓝牙媒体键：转发给当前活跃的 MediaSessionCompat。 -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
