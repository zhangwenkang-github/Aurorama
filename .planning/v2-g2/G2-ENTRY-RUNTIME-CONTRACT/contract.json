  "productGates": [
    {
      "id": "G2-RT-01-FRESH-INSTALL-IDENTITY",
      "requirement": "Fresh install and verify package, versionCode, versionName, ABI, permissions, user0 and candidate SHA before the window."
    },
    {
      "id": "G2-RT-02-AUDIOTRACK-START-COMPLETION",
      "requirement": "Observe real AudioTrack start and matching completion for every required voice; request-only, plan-only and Worker success do not count."
    },
    {
      "id": "G2-RT-03-VOICE-PROFILES-ZF-ZM",
      "requirement": "Execute both zf_001 and zm_010 with real audio in the same authorized window without freezing either profile."
    },
    {
      "id": "G2-RT-04-HEAD-MIDDLE-TAIL-CONTINUITY",
      "requirement": "Capture head, middle and tail continuity with timestamped start/completion evidence."
    },
    {
      "id": "G2-RT-05-MAX-AUDIO-GAP-15S",
      "requirement": "Maximum observed audio gap must be less than or equal to 15 seconds."
    },
    {
      "id": "G2-RT-06-FGS-MEDIASESSION-NOTIFICATION-UI-EQUALITY",
      "requirement": "Foreground service, MediaSession, notification, UI and system controls must agree on the same active or stopped state."
    },
    {
      "id": "G2-RT-07-AUDIOFOCUS-SINGLE-OWNER",
      "requirement": "One TTS audio owner holds focus; music and TTS are mutually exclusive and focus loss/gain behavior is observable."
    },
    {
      "id": "G2-RT-08-CRASH-ANR-INPUTTIMEOUT",
      "requirement": "No current-run native crash, Java fatal, ANR, InputTimeout or unexplained ApplicationExitInfo."
    },
    {
      "id": "G2-RT-09-UI-CANCEL",
      "requirement": "UI cancel is executed and converges PID, service, notification, MediaSession and audio focus without native crash."
    },
    {
      "id": "G2-RT-10-PROCESS-RESTART-RECOVERY",
      "requirement": "Process death or restart must not auto-play; recovery remains paused at the last stable sentence and revalidates the pack."
    },
    {
      "id": "G2-RT-11-APP-UID-ZERO-NETWORK",
      "requirement": "App UID network is measured across the complete window and every accounting partition; any nonzero application traffic fails."
    },
    {
      "id": "G2-RT-12-CLEANUP-CAPTURE-RESTORE",
      "requirement": "Restore packages, PID, service, notification, MediaSession, audio focus, external/internal data, logs, network and user settings; production package MATCH and device lock ACTIVE=0."
    },
    {
      "id": "G2-RT-13-SINGLE-10MIN-WINDOW-NO-RETRY",
      "requirement": "Use exactly one continuous 10-minute window per device; no extension, second attempt or substitute historical evidence."
    }
  ],
