  "$defs": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "findingValue": {
      "oneOf": [
        {
          "const": "NOT_ASSESSED"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "checkWithEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "continuitySample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "voiceId",
        "audioTrackStarted",
        "audioTrackCompleted",
        "evidence"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "voiceId": {
          "enum": [
            "zf_001",
            "zm_010"
          ]
        },
        "audioTrackStarted": {
          "type": "boolean"
        },
        "audioTrackCompleted": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "uncovered": {
            "maxItems": 0
          },
          "cleanupAndRestore": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "device": {
            "properties": {
              "order": {
                "const": "K60"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "predecessor": {
            "type": "object"
          }
        }
      }
    }
