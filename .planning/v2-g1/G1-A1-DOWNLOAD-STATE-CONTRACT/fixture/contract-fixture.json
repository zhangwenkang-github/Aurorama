  "equations": [
    {
      "id": "EQ-IDENTITY",
      "expression": "same(downloadKey) iff version==v1 and serverId==userId==itemId==mediaSourceId are all non-empty and pairwise equal",
      "unknownResult": "UNKNOWN_NO_MERGE"
    },
    {
      "id": "EQ-ACCEPT",
      "expression": "accepted iff persistent(row) and generationMatches and sourceMatches and acceptedAt>0",
      "unknownResult": "NOT_ACCEPTED"
    },
    {
      "id": "EQ-COMPLETE",
      "expression": "COMPLETED iff accepted and doneEvidence(doneAt<=deadlineAt) and generationMatches and sourceMatches and mediaCommitted and manifestCommitted and persistentStateCommitted and fileReadable and observedBytesMatch",
      "unknownResult": "NOT_COMPLETED"
    },
    {
      "id": "EQ-FINALIZE",
      "expression": "FINALIZING exposes RUNNING and may enter COMPLETED only after all mandatory artifacts and the persistent terminal state commit",
      "unknownResult": "RUNNING"
    },
    {
      "id": "EQ-TERMINAL-NOTICE",
      "expression": "emit at most once per (downloadKey,generation,terminalKind) when current and not deleteRequested",
      "unknownResult": "NO_NOTIFICATION"
    },
    {
      "id": "EQ-ACTIVE-COUNT",
      "expression": "pageQueueCount == drawerBadgeCount == activeNotificationCount == count(activeCount states in the same projectionEpoch)",
      "unknownResult": "DIAGNOSTIC_ONLY"
    },
    {
      "id": "EQ-OFFLINE-COUNT",
      "expression": "offlineCount == count(COMPLETED and availability==AVAILABLE and deleteRequested==false)",
      "unknownResult": "NO_OFFLINE_ITEM"
    },
    {
      "id": "EQ-DELETE-COMMIT",
      "expression": "deleteCommitted iff all {files,sidecar,persistentState,offlineProjection,terminalNotification} are CONFIRMED for the same deleteReceiptId",
      "unknownResult": "DELETING_FAILED"
    },
    {
      "id": "EQ-DELETE-PROJECTION",
      "expression": "deleteRequested immediately removes COMPLETED visibility and terminal notification; DELETING remains in activeCount until all child receipts commit",
      "unknownResult": "DELETING"
    },
    {
      "id": "EQ-RESTART",
      "expression": "restart maps RUNNING->PENDING only with stale lease, preserves FINALIZING/DELETING, and never invents COMPLETED from paths or Worker state",
      "unknownResult": "RECONCILE_PENDING"
    }
  ],
