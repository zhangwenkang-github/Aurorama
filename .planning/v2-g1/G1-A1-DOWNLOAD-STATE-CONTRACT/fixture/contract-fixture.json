  "capabilityGaps": [
    {
      "id": "GAP-IDENTITY",
      "current": "DownloadTask 仅保留部分 serverId/userId；书籍 sidecar 仍允许 mediaSourceId 缺失",
      "required": "四段 versioned canonical identity 全量非空；缺段为 UNKNOWN_NO_MERGE",
      "impact": "P2"
    },
    {
      "id": "GAP-CAUSAL-FIELDS",
      "current": "现有模型有 taskGeneration/updatedAt/nextRetryAt，但无通用 acceptedAt/doneAt/finalizeDeadlineAt",
      "required": "持久化 attempt 因果字段并参与 CAS",
      "impact": "P2"
    },
    {
      "id": "GAP-CANCEL",
      "current": "DownloadLifecycle.beginCancellation 将状态写成 FAILED",
      "required": "内部 CANCELLED receipt，不得归入 FAILED 或发失败通知",
      "impact": "P2"
    },
    {
      "id": "GAP-NOTIFICATION",
      "current": "通知以 sourceId hash 和固定前台 ID 标识，完成点击回 HOME，无 canonical purge API",
      "required": "notificationTag=downloadKey，携带 generation，精确一次投递与可证明 purge",
      "impact": "P2"
    },
    {
      "id": "GAP-FINALIZER-SEVERITY",
      "current": "DownloadPostCommitEffect 下所有后置子项失败被同一 Incomplete 集合表达",
      "required": "必需与可选增强分级；可选失败不阻塞 COMPLETED",
      "impact": "P2"
    },
    {
      "id": "GAP-PROJECTION",
      "current": "页面、角标、通知与离线项的计数由不同调用点组合，缺少同一 projectionEpoch 的静态证明",
      "required": "所有消费者读取同一活动键集合与离线键集合",
      "impact": "P2"
    }
  ],
  "fakeBoundaries": [
    "静态 fixture 不能证明 Android NotificationManager 实际投递、权限或 PendingIntent 路由。",
    "Worker SUCCESS 或 fake Worker 结果不能证明媒体字节、文件可读性或持久状态完成。",
    "内存 transition fixture 不能证明 Room、sidecar、文件系统与主库 WAL 的真实事务映射。",
    "模拟删除 ledger 不能证明文件系统删除、系统通知 purge 或 force-stop 后不复活。",
    "路径存在或目录扫描不能替身媒体打开 / 播放 / 阅读。",
    "静态计数测试不能证明 Compose 页面、抽屉角标和系统通知在同一真实时刻渲染相同值。"
  ]
}
