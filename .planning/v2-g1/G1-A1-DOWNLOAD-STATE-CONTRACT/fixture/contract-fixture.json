  "attemptFields": [
    {
      "name": "downloadKey",
      "required": true,
      "meaning": "D129 的四段 canonical identity，跨 DB、sidecar、通知、UI 与回执共用。"
    },
    {
      "name": "generation",
      "required": true,
      "meaning": "每次重试、暂停后恢复、取消、删除、重新下载与新 claim 推进；旧代次一律失败关闭。"
    },
    {
      "name": "sourceEpoch",
      "required": true,
      "meaning": "本次解析得到的 source/range validator 版本；source 改变不得沿用旧 done 证据。"
    },
    {
      "name": "acceptedAt",
      "required": true,
      "meaning": "Worker claim 或持久队列受理时刻；没有受理锚点不得开始运行。"
    },
    {
      "name": "doneAt",
      "required": true,
      "meaning": "传输完成事实的观测时刻；Worker SUCCESS 不等于 doneAt。"
    },
    {
      "name": "deadlineAt",
      "required": true,
      "meaning": "当前阶段最长等待边界；超时只能失败关闭或新 generation，不能补写成功。"
    },
    {
      "name": "leaseRevision",
      "required": true,
      "meaning": "运行租约版本；重启或 UI 重建只观察，不自行续租。"
    },
    {
      "name": "deleteReceiptId",
      "requiredWhen": "deleteRequested",
      "meaning": "确定性删除回执键，携带 generation 与逐子项确认。"
    },
    {
      "name": "notificationTag",
      "required": true,
      "meaning": "稳定通知 tag，建议使用 downloadKey；系统通知 ID 不再是业务身份。"
    },
    {
      "name": "projectionEpoch",
      "required": true,
      "meaning": "页面、角标、离线库和通知共同读取的单调投影版本。"
    }
  ],
