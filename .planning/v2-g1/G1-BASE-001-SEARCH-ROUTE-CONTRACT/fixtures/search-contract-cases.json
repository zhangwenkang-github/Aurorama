  "restoreCases": [
    {
      "id": "RS-01",
      "sameProcess": true,
      "shapeMatches": true,
      "selectionPresent": true,
      "expected": {
        "query": "RESTORED",
        "scope": "RESTORED",
        "results": "RESTORED",
        "scroll": "RESTORED",
        "selection": "RESTORED"
      }
    },
    {
      "id": "RS-02",
      "sameProcess": true,
      "shapeMatches": true,
      "selectionPresent": false,
      "expected": {
        "query": "RESTORED",
        "scope": "RESTORED",
        "results": "RESTORED",
        "scroll": "RESTORED",
        "selection": "CLEARED_MISSING_IDENTITY"
