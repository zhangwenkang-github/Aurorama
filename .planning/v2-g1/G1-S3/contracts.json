      "response": {
        "status": {
          "200": "PlaybackInfoResponse",
          "401": "unauthorized",
          "403": "forbidden",
          "404": "ProblemDetails",
          "503": "temporarily unavailable"
        },
        "schema": "PlaybackInfoResponse",
        "fields": {
          "MediaSources": "MediaSourceInfo[]",
          "PlaySessionId": "string?",
          "ErrorCode": "PlaybackErrorCode?"
        },
        "playbackErrorCodes": [
          "NotAllowed",
          "NoCompatibleStream",
          "RateLimitExceeded"
        ],
        "serverMappingsStaticallyProven": {
          "NoCompatibleStream": "MediaSources is empty",
          "PlaySessionId": "new identifier when MediaSources is non-empty"
        },
        "serverMappingsNotProvenForThisEndpoint": [
          "NotAllowed",
          "RateLimitExceeded"
        ]
      },
      "stateRules": [
        "Success requires HTTP 2xx plus MediaSources and a usable PlaySessionId.",
        "ErrorCode must be inspected before choosing playback.",
        "PlaySessionId must be propagated to stream/session reporting and must not be synthesized.",
        "PlaybackInfo is not globally side-effect-free: .strm or missing main media streams can trigger a full metadata refresh.",
        "AutoOpenLiveStream can open a live source and must remain outside zero-side-effect probes."
      ],
      "clientCurrentShape": {
        "method": "POST",
        "requestFieldsObserved": [
          "UserId",
          "DeviceProfile",
          "MaxStreamingBitrate",
          "StartTimeTicks",
          "EnableTranscoding",
          "EnableDirectPlay",
          "EnableDirectStream",
          "AllowVideoStreamCopy",
          "AllowAudioStreamCopy"
        ],
        "responseUsesOnly": [
          "MediaSources"
        ],
        "discardedResponseFields": [
          "PlaySessionId",
          "ErrorCode"
        ],
        "playbackReportingGap": "start/progress reports do not carry PlaySessionId/MediaSourceId and force DirectPlay"
      },
      "successAnchor": [
        "HTTP 200",
        "MediaSources non-empty",
        "ErrorCode null",
        "PlaySessionId captured",
        "selected MediaSource and PlayMethod retained in session state"
      ]
    },
    "DOWNLOAD_RANGE": {
      "request": {
        "method": "GET",
        "path": "/Items/{itemId}/Download",
        "pathParameters": {
          "itemId": {
            "type": "string",
            "format": "uuid",
            "required": true
          }
        },
        "rangeHeaders": {
          "initial": [],
          "resume": [
            "Range: bytes=<localOffset>-",
            "If-Range: <strong ETag or Last-Modified>"
          ]
        },
        "redirectRule": "Strip Jellyfin authorization headers when scheme/host/port changes."
      },
      "response": {
        "declaredStatus": {
          "200": "binary media",
          "401": "unauthorized",
          "403": "forbidden",
          "404": "ProblemDetails",
          "503": "temporarily unavailable"
        },
        "rangeStatusInferredFromServerSource": {
          "200": "full body; reset local partial file to zero",
          "206": "partial body; Content-Range start MUST equal local offset",
          "416": "Content-Range bytes */total; complete only when local offset is known to equal total"
        },
        "validators": [
          "ETag",
          "Last-Modified"
        ],
        "completionChecks": [
          "body length equals declared range length",
          "final file length equals expected total",
          "fsync before terminal success",
          "206 start equals requested offset"
        ]
      },
      "stateRules": [
        "401 and 403 are different user-visible permissions states.",
        "A 200 to a Range request means the server ignored Range or validator changed; restart from byte zero.",
        "416 is not automatically success.",
        "GET /Items/{id}/Download writes an ActivityLog when a user is present and is not a zero-side-effect production probe."
      ],
      "clientCurrentShape": {
        "pathKind": "OFFICIAL_DOWNLOAD",
        "rangeSupported": true,
        "ifRangeSupported": true,
        "redirectCredentialStripping": true,
        "current401403Mapping": "both become AUTHENTICATION",
        "current404409Mapping": "generic SERVER_ERROR",
        "current416Mapping": "complete if offset >= Content-Range total, else CANNOT_RESUME"
      },
      "successAnchor": [
        "200 with complete body and expected total",
        "206 with matching start and complete final byte count",
        "416 only when Content-Range total proves local file already complete"
      ]
    },
