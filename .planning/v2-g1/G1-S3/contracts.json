      "stateRules": [
        "Local intent is not server acceptance.",
        "HTTP 2xx response is an acceptance anchor; requested fields still require DTO/read-back comparison.",
        "403 maps to DENIED and MUST NOT be retried with the same credentials.",
        "401 maps to AUTHENTICATION and pauses the origin-scoped queue.",
        "404 fails the item closed.",
        "409 has no declared UserData contract in OpenAPI 12.4.0; if observed it remains UNCOVERED and must not be silently retried as success."
      ],
      "clientCurrentShape": {
        "requestFieldsUsed": [
          "PlaybackPositionTicks",
