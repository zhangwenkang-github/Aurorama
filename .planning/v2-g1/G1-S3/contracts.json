{
  "schemaVersion": "g1-s3-contracts/v1",
  "scope": "STATIC_CONTRACT_CORPUS_ONLY",
  "sanitization": {
    "containsCredentials": false,
    "containsServerAddress": false,
    "containsUserData": false,
    "authShape": "Authorization: MediaBrowser Token=\"<REDACTED>\"",
    "protocolPassClaimed": false
  },
  "commonErrorStatusMapping": {
    "401": {
      "semantic": "UNAUTHORIZED",
      "clientAction": "AUTHENTICATE_OR_REFRESH_SESSION",
      "autoRetryWithSameCredential": false,
      "openApiEvidence": "declared on the reviewed Jellyfin API operations"
    },
    "403": {
      "semantic": "FORBIDDEN_PERMISSION_DENIED",
      "clientAction": "SURFACE_DENIED_NO_AUTOMATIC_RETRY",
      "autoRetryWithSameCredential": false,
      "openApiEvidence": "declared on the reviewed Jellyfin API operations"
    },
    "404": {
      "semantic": "ITEM_OR_ENDPOINT_NOT_FOUND",
      "clientAction": "FAIL_CLOSED_AND_REFRESH_REFERENCE",
      "retryPolicy": "NO_AUTOMATIC_RETRY"
    },
    "409": {
      "semantic": "CONFLICT",
      "clientAction": "STOP_OPTIMISTIC_WRITE_RESNAPSHOT_THEN_DECIDE",
      "openApiEvidence": "NOT_DECLARED on PlaybackInfo, Download, UserData, Items search or SyncPlay paths in OpenAPI 12.4.0",
      "contractClosure": "UNCOVERED"
    },
    "416": {
      "semantic": "RANGE_NOT_SATISFIABLE",
      "clientAction": "IF_LOCAL_OFFSET_EQUALS_CONTENT_RANGE_TOTAL_THEN_COMPLETE_ELSE_RESET_ONCE_THEN_FAIL",
      "requires": [
        "Range: bytes=<offset>-",
        "Content-Range: bytes */<total>"
      ],
      "openApiEvidence": "206 and 416 are not declared in the OpenAPI Download response map; static source enables ASP.NET Core range processing",
      "contractClosure": "STATIC_INFERENCE_ONLY"
    },
    "503": {
      "semantic": "TEMPORARILY_UNAVAILABLE",
      "clientAction": "BACKOFF_AND_RETRY_WITHOUT_TREATING_AS_DATA_LOSS",
      "headers": [
        "Retry-After",
        "Message"
      ]
    }
  },
