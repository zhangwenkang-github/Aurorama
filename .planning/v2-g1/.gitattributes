# G1 evidence text files use LF regardless of core.autocrlf; binary formats are intentionally unmatched.
/.gitattributes text eol=lf
**/.gitattributes text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.svg text eol=lf
*.html text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.txt text eol=lf
*.log text eol=lf
*.m3u8 text eol=lf
