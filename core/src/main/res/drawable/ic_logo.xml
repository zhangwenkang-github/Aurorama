<?xml version="1.0" encoding="utf-8"?>
<!--
  极光幕（Aurorama）应用内标记 · 与启动图标同构（方向 1「极光帘幕」）。
  1) 暗场圆角片底保证在亮色表面上仍有轮廓；2) 极光丝带自左上流下（青 → 蓝）；
  3) 幕布地平线收在下方。全部矢量，最小用到 18dp（控制台返回胶囊）仍可读。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- 暗场片底 -->
    <path android:pathData="M26,10 L74,10 A16,16 0 0 1 90,26 L90,74 A16,16 0 0 1 74,90 L26,90 A16,16 0 0 1 10,74 L10,26 A16,16 0 0 1 26,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="18"
                android:startY="12"
                android:endX="84"
                android:endY="90"
                android:type="linear">
                <item android:offset="0" android:color="#FF191C20" />
                <item android:offset="1" android:color="#FF0B0C0E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 发丝描边 -->
    <path
        android:pathData="M26,10 L74,10 A16,16 0 0 1 90,26 L90,74 A16,16 0 0 1 74,90 L26,90 A16,16 0 0 1 10,74 L10,26 A16,16 0 0 1 26,10 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FF2E3237"
        android:strokeWidth="2" />

    <!-- 极光丝带：自左上流下 -->
    <path android:pathData="M40,20 C52,30 58,42 56,54 C54,66 46,74 42,84 L30,84 C36,74 42,66 40,54 C38,42 30,30 22,22 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="20"
                android:endX="48"
                android:endY="84"
                android:type="linear">
                <item android:offset="0" android:color="#FF5CE1D2" />
                <item android:offset="1" android:color="#FF7CC4FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 幕布地平线 -->
    <path
        android:pathData="M22,74 C36,67 64,67 78,74"
        android:fillColor="#00000000"
        android:strokeColor="#FF7CC4FF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
