<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- 画框：深灰蓝渐变的圆角方形，象征银幕 -->
    <path android:pathData="M32,8 L68,8 A24,24 0 0 1 92,32 L92,68 A24,24 0 0 1 68,92 L32,92 A24,24 0 0 1 8,68 L8,32 A24,24 0 0 1 32,8 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="12"
                android:endX="82"
                android:endY="90"
                android:type="linear">
                <item android:offset="0" android:color="#FF22303E" />
                <item android:offset="1" android:color="#FF0F141A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 描边：冷灰蓝，让图标在深色底上仍有轮廓 -->
    <path
        android:pathData="M32,8 L68,8 A24,24 0 0 1 92,32 L92,68 A24,24 0 0 1 68,92 L32,92 A24,24 0 0 1 8,68 L8,32 A24,24 0 0 1 32,8 Z"
        android:strokeColor="#FF3A4756"
        android:strokeWidth="2"
        android:fillColor="#00000000" />

    <!-- 播放键：冰蓝渐变 -->
    <path android:pathData="M41,31 L41,69 L71,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="41"
                android:startY="31"
                android:endX="71"
                android:endY="69"
                android:type="linear">
                <item android:offset="0" android:color="#FFB6DBF7" />
                <item android:offset="1" android:color="#FF6FA8DE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 暖金进度条：呼应“继续观看” -->
    <path
        android:pathData="M37,78 L63,78 A2,2 0 0 1 63,82 L37,82 A2,2 0 0 1 37,78 Z"
        android:fillColor="#FFE8C07A" />
</vector>
