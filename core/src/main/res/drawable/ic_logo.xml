<?xml version="1.0" encoding="utf-8"?>
<!--
  影阁标记：一格胶片 + 一枚朱砂播放键。
  胶片齿孔用低透明度宣纸白，只在深色底上留出轮廓；
  唯一的饱和色留给了播放键，对应界面上"朱砂只表示要播的内容"。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- 片格底 -->
    <path android:pathData="M26,10 L74,10 A16,16 0 0 1 90,26 L90,74 A16,16 0 0 1 74,90 L26,90 A16,16 0 0 1 10,74 L10,26 A16,16 0 0 1 26,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="18"
                android:startY="12"
                android:endX="84"
                android:endY="90"
                android:type="linear">
                <item android:offset="0" android:color="#FF191C20" />
                <item android:offset="1" android:color="#FF0B0C0E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 片格描边：发丝线 -->
    <path
        android:pathData="M26,10 L74,10 A16,16 0 0 1 90,26 L90,74 A16,16 0 0 1 74,90 L26,90 A16,16 0 0 1 10,74 L10,26 A16,16 0 0 1 26,10 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FF2E3237"
        android:strokeWidth="2" />

    <!-- 左右齿孔 -->
    <path android:pathData="M18,30 L24,30 A2,2 0 0 1 26,32 L26,42 A2,2 0 0 1 24,44 L18,44 A2,2 0 0 1 16,42 L16,32 A2,2 0 0 1 18,30 Z" android:fillColor="#59F1EDE6" />
    <path android:pathData="M18,56 L24,56 A2,2 0 0 1 26,58 L26,68 A2,2 0 0 1 24,70 L18,70 A2,2 0 0 1 16,68 L16,58 A2,2 0 0 1 18,56 Z" android:fillColor="#59F1EDE6" />
    <path android:pathData="M76,30 L82,30 A2,2 0 0 1 84,32 L84,42 A2,2 0 0 1 82,44 L76,44 A2,2 0 0 1 74,42 L74,32 A2,2 0 0 1 76,30 Z" android:fillColor="#59F1EDE6" />
    <path android:pathData="M76,56 L82,56 A2,2 0 0 1 84,58 L84,68 A2,2 0 0 1 82,70 L76,70 A2,2 0 0 1 74,68 L74,58 A2,2 0 0 1 76,56 Z" android:fillColor="#59F1EDE6" />

    <!-- 朱砂播放键 -->
    <path android:pathData="M43,34 L43,66 L69,50 Z" android:fillColor="#FFD2553C" />
</vector>
