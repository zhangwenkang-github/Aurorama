<?xml version="1.0" encoding="utf-8"?>
<!--
  B「极幕之眼」（K1 定稿，docs/design/_src/direction-k1.html icon-b 段）：极光渐变光圈 + 切口光束 + 极星。
  图形取自启动图标前景 ic_launcher_foreground.xml 同一套 560 设计稿坐标，按 ×0.2 居中到 100dp 画布
  （启动图标 ×0.136 是为 108dp 自适应画布留 66dp 安全区，应用内标记需要更饱满的构图）。
  纯前景、不依赖背景层：渐变光圈 / 光束 / 极星全部自绘，18dp（控制台返回胶囊）到 120dp（关于页）同一份资源。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <group android:translateX="-6" android:translateY="-6"
        android:scaleX="0.2" android:scaleY="0.2">
        <!-- 极光渐变光圈：虚线圆环换算为 265.3° 圆弧（dasharray 880/320、rotate -128°） -->
        <path android:pathData="M163.02,130.28 A190,190 0 1 1 140.22,408.69"
            android:fillColor="#00000000" android:strokeWidth="46" android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="90" android:startY="90" android:endX="470" android:endY="470">
                    <item android:offset="0" android:color="#FF3DE8C2"/>
                    <item android:offset="0.55" android:color="#FF6FA0FF"/>
                    <item android:offset="1" android:color="#FFB07CFF"/>
                </gradient>
            </aapt:attr>
        </path>
        <!-- 幕布切口中的一束光 -->
        <path android:pathData="M382,356 L452,424 L402,452 L340,372 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="340" android:startY="356" android:endX="452" android:endY="452">
                    <item android:offset="0" android:color="#FF3DE8C2"/>
                    <item android:offset="0.55" android:color="#FF6FA0FF"/>
                    <item android:offset="1" android:color="#FFB07CFF"/>
                </gradient>
            </aapt:attr>
        </path>
        <!-- 极星 -->
        <path android:pathData="M183,180 a13,13 0 1 1 26,0 a13,13 0 1 1 -26,0"
            android:fillColor="#FFEAFBFF"/>
    </group>
</vector>
